# 이 파일을 .env로 복사해 실제 값을 채운다. .env는 커밋되지 않는다.

# 국토교통부 토지 매매 실거래가 API (data.go.kr)
# 반드시 Decoding 키를 사용한다. 서버 전용 — NEXT_PUBLIC_ 접두어 금지
RTMS_SERVICE_KEY=

# VWorld WMTS 배경지도 인증키 (vworld.kr에서 발급, 무료)
# 브라우저에서 타일을 직접 요청하므로 노출이 전제된 값이다
# 타일 URL: https://api.vworld.kr/req/wmts/1.0.0/{KEY}/white/{z}/{y}/{x}.png
# tiletype 유효값: Base, white, midnight, Hybrid, Satellite(jpeg)
NEXT_PUBLIC_VWORLD_KEY=

# PostGIS (docker-compose) — ETL 전용.
# 원본 SHP 적재와 공간 연산(ST_MakeValid 등)은 계속 여기서 한다.
# 웹은 더 이상 PostgreSQL을 보지 않는다 (아래 Turso 참고)
PGHOST=localhost
PGPORT=5432
PGDATABASE=ddotoro
PGUSER=ddotoro
PGPASSWORD=

# Turso (libSQL) — 웹이 읽는 DB. 서버 전용, NEXT_PUBLIC_ 접두어 금지
#
# PostGIS 결과를 etl/export_sqlite.py로 SQLite 한 파일로 굽고 Turso에 올린다.
# 무료 5GB 안에 들어가며(실측 3.9GB) 공간 연산은 전부 적재 시점에 끝나 있다.
#
# 배포 전 검증은 파일 URL로 한다 — 토큰이 필요 없다:
#   TURSO_DATABASE_URL=file:/절대경로/etl/out/ddotoro.db
# 원격:
#   TURSO_DATABASE_URL=https://<db>-<org>.turso.io  (배포는 반드시 https)
#   TURSO_AUTH_TOKEN=  (turso db tokens create <db>)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 정적 자산 주소 — 지도 타일과 필지 상세를 받아오는 곳
#
# etl/out/assets를 통째로 S3/Vercel Blob에 올리고 그 접두어를 넣는다.
#   assets/tiles/{z}/{x}/{y}.json.gz      etl/build_tiles.py    (브라우저가 받음)
#   assets/details/{법정동10}/{끝자리}.json.gz  etl/build_details.py  (서버가 받음)
#
# 이미 gzip으로 구워져 있으므로 업로드할 때 반드시 헤더를 붙인다.
# 안 붙이면 브라우저가 압축을 풀지 못해 깨진 JSON을 받는다:
#   Content-Encoding: gzip
#   Content-Type: application/json
#   NEXT_PUBLIC_ASSET_BASE_URL=https://<버킷>.s3.<리전>.amazonaws.com/assets
#
# 비워두면 개발용 라우트(/api/assets)가 etl/out/assets를 직접 읽는다.
# 그 디렉토리는 gitignore 대상이라 배포 번들에 없다 — 배포에는 필수다
NEXT_PUBLIC_ASSET_BASE_URL=

# 네이버 검색 API (developers.naver.com) — 지역 부동산 뉴스용, 선택
# 없으면 뉴스 섹션이 조용히 숨겨지고 나머지는 정상 동작한다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
